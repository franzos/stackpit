common-error-prefix = Ошибка:
nav-logout = Выйти
common-id-prefix = id:
common-time-just-now = только что
common-time-min-ago = { $n } мин назад
common-time-hour-ago = { $n } ч назад
common-time-day-ago = { $n ->
    [one] { $n } день назад
